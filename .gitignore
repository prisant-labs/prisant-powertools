# Local-only working notes. Never committed, never cited in tracked files.
_local/
_LOCAL/

# Generated skill outputs. The glob covers named variants such as
# _output-jp-library/, which the bare _output/ pattern missed.
_output*/

# Python
__pycache__/
*.pyc

# Node
node_modules/

# Local tooling state
.memsearch/

# OS
.DS_Store
Thumbs.db

# Local dev marketplace only. Published distribution is the standalone
# prisant-labs/agent-plugins repo (D-2); an embedded marketplace must never ship.
.claude-plugin/marketplace.json

# Project-level skill copies used to test an unreleased skill before it ships
# (AU-01 Phase 7). Never committed: the plugin, not this folder, is what users load.
.claude/skills/

# Git worktrees that Claude Code creates for isolated subagents. Each holds a full
# checkout of this repository, so leaving it unignored shows the whole folder as
# untracked in the parent checkout.
.claude/worktrees/

# claude plugin eval results (R5). Each run writes a timestamped report and
# JSON under here; these are run artifacts, not suite source, and are never committed.
evals/results/
